{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    //
    // `ES2022` nu e opțional aici: proiectul ajunge să verifice și fișiere de view, fiindcă orice test
    // care importă rutele le aduce pe toate, prin `import()`-urile leneșe. View-urile folosesc bunuri
    // ES2022 (`Array.prototype.at`, de exemplu), iar cu `lib: []` cădeau doar când un test nou atingea
    // rutele — adică exact genul de eroare care apare la altcineva, nu la cel care a scris view-ul.
    // `DOM` rămâne afară: testele merg pe `jsdom` prin `types`.
    "lib": ["ES2022"],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
