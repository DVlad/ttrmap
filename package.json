{
  "name": "ttrmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:android": "vite build --mode android && cap sync android",
    "open:android": "cap open android",
    "preview": "vite preview",
    "test:unit": "vitest",
    "check:map": "node scripts/check-map.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint-ci": "run-s lint-ci:*",
    "lint-ci:oxlint": "oxlint .",
    "lint-ci:eslint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@tailwindcss/vite": "^4.3.2",
    "maplibre-gl": "^6.11.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
